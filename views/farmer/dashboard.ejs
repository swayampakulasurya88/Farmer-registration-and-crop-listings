<%- include('../partials/header') %>

<div class="page-head dash-head">
  <div>
    <h1>👨‍🌾 <%= t('farmer.dashTitle', { name: farmer.name }) %></h1>
    <p class="muted"><%= farmer.village %> · <%= farmer.landSize || '' %> · <%= farmer.phone %></p>
  </div>
  <a href="/farmer/listings/new" class="btn btn-primary btn-lg"><%= t('farmer.newListing') %></a>
</div>

<div class="dash-stats">
  <div class="stat-card stat-card-plain">
    <span class="stat-num"><%= activeCount %></span>
    <span class="stat-label"><%= t('farmer.activeListings') %></span>
  </div>
  <div class="stat-card stat-card-plain">
    <span class="stat-num"><%= listings.length %></span>
    <span class="stat-label"><%= t('farmer.totalPosted') %></span>
  </div>
  <div class="stat-card stat-card-plain">
    <span class="stat-num"><%= interestCount %></span>
    <span class="stat-label"><%= t('farmer.interestsReceived') %></span>
  </div>
</div>

<div class="two-col">
  <!-- ============ My listings ============ -->
  <section class="col">
    <div class="col-head">
      <h2><%= t('farmer.myListings') %></h2>
      <a href="/listings?q=<%= encodeURIComponent(farmer.name.split(' ')[0]) %>" class="btn btn-ghost btn-sm"><%= t('farmer.viewPublic') %></a>
    </div>

    <% if (listings.length) { %>
      <div class="stack">
        <% listings.forEach((l) => { %>
          <%
            const emoji = config.CROP_EMOJI[l.crop] || '🌾';
          %>
          <div class="card row-card">
            <span class="crop-emoji"><%= emoji %></span>
            <div class="row-main">
              <strong class="crop-name"><%= l.crop %> <span class="muted">· <%= l.variety %></span></strong>
              <span class="muted small">
                <%= Number(l.quantity).toLocaleString('en-IN') %> <%= l.unit %> ·
                ₹<%= Number(l.price).toLocaleString('en-IN') %>/<%= l.priceUnit.replace('per ', '') %> ·
                <%= l.location %>
              </span>
            </div>
            <span class="badge badge-status badge-<%= l.status %>"><%= t('status.' + l.status) %></span>
            <div class="row-actions">
              <a class="btn btn-ghost btn-sm" href="/listings/<%= l.id %>"><%= t('farmer.view') %></a>
              <a class="btn btn-outline btn-sm" href="/farmer/listings/<%= l.id %>/edit"><%= t('farmer.edit') %></a>
              <form method="post" action="/farmer/listings/<%= l.id %>/status" class="inline-form">
                <button class="btn btn-ghost btn-sm" type="submit" title="<%= t('farmer.toggleAvail') %>">
                  <%= l.status === 'active' ? t('farmer.sold') : t('farmer.active') %>
                </button>
              </form>
              <form method="post" action="/farmer/listings/<%= l.id %>?_method=DELETE" class="inline-form" data-confirm="<%= t('farmer.deleteConfirm') %>">
                <button class="btn btn-danger btn-sm" type="submit"><%= t('farmer.delete') %></button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p><%= t('farmer.noListings') %> <a href="/farmer/listings/new"><%= t('farmer.listFirst') %></a></p>
      </div>
    <% } %>
  </section>

  <!-- ============ Interests received ============ -->
  <section class="col">
    <h2><%= t('farmer.interestsTitle') %></h2>
    <% if (interests.length) { %>
      <div class="stack">
        <% interests.forEach(({ interest, buyer, listing }) => { %>
          <% if (!listing) return; %>
          <div class="card interest-card">
            <div class="interest-head">
              <strong>🛒 <%= buyer ? buyer.name : t('farmer.buyer') %></strong>
              <span class="muted small"><%= new Date(interest.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></span>
            </div>
            <p class="small">
              <%= t('farmer.interestedIn') %> <a href="/listings/<%= listing.id %>"><strong><%= listing.crop %></strong></a>
              (<%= Number(listing.quantity).toLocaleString('en-IN') %> <%= listing.unit %> · ₹<%= listing.price %>/<%= listing.priceUnit.replace('per ', '') %>)
            </p>
            <% if (interest.message) { %><blockquote class="interest-msg">“<%= interest.message %>”</blockquote><% } %>
            <% if (buyer) { %>
              <div class="interest-contact small">
                📞 <%= buyer.phone %> · 📍 <%= buyer.village %> · <%= buyer.businessType || '' %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p><%= t('farmer.noInterest') %></p>
      </div>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>