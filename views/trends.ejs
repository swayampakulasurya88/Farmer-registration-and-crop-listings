<%- include('partials/header') %>

<div class="page-head">
  <h1><%= t('trends.title') %></h1>
  <p><%= t('trends.sub') %></p>
  <p class="muted small"><%= t('trends.note') %></p>
</div>

<!-- Chart data -->
<script>window.CROP_CHART_DATA = <%- chartJson %>;</script>

<div class="two-charts">
  <div class="card chart-card">
    <h3><%= t('trends.priceChart') %></h3>
    <canvas id="priceChart" height="320"></canvas>
  </div>
  <div class="card chart-card">
    <h3><%= t('trends.volumeChart') %></h3>
    <canvas id="volumeChart" height="320"></canvas>
  </div>
</div>

<!-- Latest table -->
<div class="card mt">
  <h3><%= t('trends.latestRates') %></h3>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th><%= t('table.crop') %></th><th><%= t('trends.thAvg') %></th><th><%= t('table.listings') %></th><th><%= t('trends.thChange') %></th></tr>
      </thead>
      <tbody>
        <% table.forEach((r) => { %>
          <tr>
            <td><strong><%= config.CROP_EMOJI[r.crop] || '🌾' %> <%= r.crop %></strong></td>
            <td><strong>₹<%= r.price %></strong></td>
            <td><%= r.listings %></td>
            <td>
              <% if (r.hasBase && r.change !== null) { %>
                <% if (r.change > 0) { %>
                  <span class="trend up">▲ <%= r.change %>%</span>
                <% } else if (r.change < 0) { %>
                  <span class="trend down">▼ <%= Math.abs(r.change) %>%</span>
                <% } else { %>
                  <span class="trend flat">— 0%</span>
                <% } %>
              <% } else { %>
                <span class="muted"><%= t('table.notEnough') %></span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%
  const chartJs = '<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script><script src="/js/charts.js"></script>';
%>
<%- include('partials/footer', { extraScript: chartJs }) %>