<%- include('../partials/header') %>

<div class="auth-wrap">
  <div class="auth-card auth-card-wide">
    <div class="auth-head">
      <span class="auth-emoji">🌾</span>
      <h1>Create your account</h1>
      <p>Join the shared marketplace of <%= config.DISTRICT %></p>
    </div>

    <form method="post" action="/auth/register" class="form" novalidate>
      <div class="field">
        <label>I am a…</label>
        <div class="role-picker">
          <label class="role-option <%= form.role === 'farmer' || !form.role ? 'selected' : '' %>">
            <input type="radio" name="role" value="farmer" <%= form.role === 'farmer' || !form.role ? 'checked' : '' %>>
            <strong>👨‍🌾 Farmer</strong>
            <small>I grow and sell crops</small>
          </label>
          <label class="role-option <%= form.role === 'buyer' ? 'selected' : '' %>">
            <input type="radio" name="role" value="buyer" <%= form.role === 'buyer' ? 'checked' : '' %>>
            <strong>🛒 Buyer</strong>
            <small>I buy crops to trade or use</small>
          </label>
        </div>
        <% if (fieldErrors.role) { %><p class="field-error"><%= fieldErrors.role %></p><% } %>
      </div>

      <div class="form-grid">
        <div class="field">
          <label for="name">Full name</label>
          <input type="text" id="name" name="name" value="<%= form.name || '' %>" placeholder="e.g. Ramesh Chandra" required>
          <% if (fieldErrors.name) { %><p class="field-error"><%= fieldErrors.name %></p><% } %>
        </div>
        <div class="field">
          <label for="phone">Phone number</label>
          <input type="tel" id="phone" name="phone" value="<%= form.phone || '' %>" placeholder="98765 12345" required>
          <% if (fieldErrors.phone) { %><p class="field-error"><%= fieldErrors.phone %></p><% } %>
        </div>
        <div class="field">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" value="<%= form.email || '' %>" placeholder="you@example.com" required>
          <% if (fieldErrors.email) { %><p class="field-error"><%= fieldErrors.email %></p><% } %>
        </div>
        <div class="field">
          <label for="password">Password (min 6 chars)</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required>
          <% if (fieldErrors.password) { %><p class="field-error"><%= fieldErrors.password %></p><% } %>
        </div>
        <div class="field">
          <label for="village">Village / town</label>
          <select id="village" name="village" required>
            <option value="">— Select from <%= config.DISTRICT %> —</option>
            <% villages.forEach((v) => { %>
              <option value="<%= v %>" <%= form.village === v ? 'selected' : '' %>><%= v %></option>
            <% }) %>
          </select>
          <% if (fieldErrors.village) { %><p class="field-error"><%= fieldErrors.village %></p><% } %>
        </div>

        <div class="field farmer-only <%= form.role === 'buyer' ? 'hidden' : '' %>">
          <label for="landSize">Land size (farmer)</label>
          <input type="text" id="landSize" name="landSize" value="<%= form.landSize || '' %>" placeholder="e.g. 5 acres">
          <% if (fieldErrors.landSize) { %><p class="field-error"><%= fieldErrors.landSize %></p><% } %>
        </div>

        <div class="field buyer-only <%= form.role === 'farmer' || !form.role ? 'hidden' : '' %>">
          <label for="businessType">Business type (buyer)</label>
          <select id="businessType" name="businessType">
            <option value="">— Select —</option>
            <% businessTypes.forEach((t) => { %>
              <option value="<%= t %>" <%= form.businessType === t ? 'selected' : '' %>><%= t %></option>
            <% }) %>
          </select>
          <% if (fieldErrors.businessType) { %><p class="field-error"><%= fieldErrors.businessType %></p><% } %>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg">Create account</button>
    </form>

    <p class="auth-foot">Already have an account? <a href="/auth/login">Login</a></p>
  </div>
</div>

<%- include('../partials/footer') %>