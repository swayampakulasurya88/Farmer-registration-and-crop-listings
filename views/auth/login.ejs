<%- include('../partials/header') %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-head">
      <span class="auth-emoji">🌾</span>
      <h1>Welcome back</h1>
      <p>Log in to KrishiSetu — <%= config.DISTRICT %></p>
    </div>

    <form method="post" action="/auth/login" class="form" novalidate>
      <div class="field">
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" value="<%= form.email || '' %>" placeholder="you@example.com" required autofocus>
        <% if (fieldErrors.email) { %><p class="field-error"><%= fieldErrors.email %></p><% } %>
      </div>

      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg">Login</button>
    </form>

    <p class="auth-foot">New here? <a href="/auth/register">Create an account</a></p>

    <details class="demo-cred">
      <summary>Demo accounts (click to reveal)</summary>
      <ul>
        <li><strong>Farmer:</strong> ramesh@demo.in / farmer123</li>
        <li><strong>Buyer:</strong> buyer@demo.in / buyer123</li>
        <li><strong>Admin:</strong> admin@krishisetu.gov / admin123</li>
      </ul>
    </details>
  </div>
</div>

<%- include('../partials/footer') %>