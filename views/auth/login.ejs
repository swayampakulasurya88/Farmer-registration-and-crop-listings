<%- include('../partials/header') %>

<div class="auth-wrap">
  <div class="auth-card auth-card-wide">
    <div class="auth-head">
      <span class="auth-emoji">🌾</span>
      <h1><%= t('auth.welcomeTitle') %></h1>
      <p><%= config.DISTRICT %> — <strong><%= t('auth.welcomeSub') %></strong></p>
    </div>

    <div class="auth-tabs" role="tablist">
      <button type="button" class="auth-tab <%= tab === 'admin' ? '' : 'active' %>" data-ks-tab="panel-user"><%= t('auth.userTab') %></button>
      <button type="button" class="auth-tab <%= tab === 'admin' ? 'active' : '' %>" data-ks-tab="panel-admin"><%= t('auth.adminTab') %></button>
    </div>

    <!-- ================= Farmer / Buyer entry ================= -->
    <section class="auth-panel <%= tab === 'admin' ? 'hidden' : '' %>" id="panel-user">
      <p class="auth-lead"><%= t('auth.userLead') %></p>

      <form method="post" action="/auth/login" class="form" novalidate>
        <input type="hidden" name="tab" value="user">

        <div class="field">
          <label><%= t('auth.iAm') %></label>
          <div class="role-picker">
            <label class="role-option <%= form.role === 'buyer' ? '' : 'selected' %>">
              <input type="radio" name="role" value="farmer" <%= form.role === 'buyer' ? '' : 'checked' %>>
              <strong><%= t('auth.roleFarmer') %></strong>
              <small><%= t('auth.roleFarmerSub') %></small>
            </label>
            <label class="role-option <%= form.role === 'buyer' ? 'selected' : '' %>">
              <input type="radio" name="role" value="buyer" <%= form.role === 'buyer' ? 'checked' : '' %>>
              <strong><%= t('auth.roleBuyer') %></strong>
              <small><%= t('auth.roleBuyerSub') %></small>
            </label>
          </div>
          <% if (fieldErrors.role) { %><p class="field-error"><%= fieldErrors.role %></p><% } %>
        </div>

        <div class="form-grid">
          <div class="field">
            <label for="name"><%= t('auth.fullName') %></label>
            <input type="text" id="name" name="name" value="<%= form.name || '' %>" placeholder="<%= t('auth.namePh') %>" required autofocus>
            <% if (fieldErrors.name) { %><p class="field-error"><%= fieldErrors.name %></p><% } %>
          </div>
          <div class="field">
            <label for="phone"><%= t('auth.mobile') %></label>
            <input type="tel" id="phone" name="phone" value="<%= form.phone || '' %>" placeholder="98765 12345" required>
            <% if (fieldErrors.phone) { %><p class="field-error"><%= fieldErrors.phone %></p><% } %>
          </div>
          <div class="field">
            <label for="village"><%= t('auth.village') %></label>
            <select id="village" name="village">
              <option value=""><%= t('auth.selectOptional') %></option>
              <% villages.forEach((v) => { %>
                <option value="<%= v %>" <%= form.village === v ? 'selected' : '' %>><%= v %></option>
              <% }) %>
            </select>
            <% if (fieldErrors.village) { %><p class="field-error"><%= fieldErrors.village %></p><% } %>
          </div>
          <div class="field">
            <label for="address"><%= t('auth.address') %></label>
            <input type="text" id="address" name="address" value="<%= form.address || '' %>" placeholder="<%= t('auth.addressPh') %>">
            <% if (fieldErrors.address) { %><p class="field-error"><%= fieldErrors.address %></p><% } %>
          </div>
        </div>

        <div class="field farmer-only hidden">
          <label for="landSize"><%= t('auth.landSize') %></label>
          <input type="text" id="landSize" name="landSize" value="<%= form.landSize || '' %>" placeholder="<%= t('auth.landSizePh') %>">
        </div>

        <div class="field buyer-only hidden">
          <label for="businessType"><%= t('auth.businessType') %></label>
          <select id="businessType" name="businessType">
            <option value=""><%= t('auth.select') %></option>
            <% businessTypes.forEach((t) => { %>
              <option value="<%= t %>" <%= form.businessType === t ? 'selected' : '' %>><%= t %></option>
            <% }) %>
          </select>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg mt"><%= t('auth.enterBtn') %></button>
        <p class="auth-micro"><%= t('auth.noPassword') %></p>
      </form>
    </section>

    <!-- ================= Admin login ================= -->
    <section class="auth-panel <%= tab === 'admin' ? '' : 'hidden' %>" id="panel-admin">
      <p class="auth-lead"><%= t('auth.adminLead') %></p>

      <form method="post" action="/auth/login" class="form" novalidate>
        <input type="hidden" name="tab" value="admin">

        <div class="field">
          <label for="login"><%= t('auth.userOrEmail') %></label>
          <input type="text" id="login" name="login" value="<%= form.login || '' %>" placeholder="SURYAS" required autofocus>
          <% if (fieldErrors.login) { %><p class="field-error"><%= fieldErrors.login %></p><% } %>
        </div>

        <div class="field">
          <label for="password"><%= t('auth.password') %></label>
          <input type="password" id="password" name="password" placeholder="••••••••" required>
        </div>

        <p class="forgot-link"><a href="/auth/forgot"><%= t('auth.forgot') %></a></p>

        <button type="submit" class="btn btn-primary btn-block btn-lg"><%= t('auth.adminSubmit') %></button>
      </form>
    </section>

    <details class="demo-cred">
      <summary><%= t('auth.demoTitle') %></summary>
      <ul>
        <li><strong><%= t('auth.demoFarmer') %>:</strong> Ramesh Chandra · <b>9876512341</b> · Andipalem</li>
        <li><strong><%= t('auth.demoBuyer') %>:</strong> Sri Sai Traders · <b>9988776655</b> · Vijayawada</li>
        <li><strong><%= t('auth.demoAdmin') %>:</strong> <b>SURYAS</b> / SURYAS2007</li>
      </ul>
    </details>
  </div>
</div>

<script>
  (function () {
    'use strict';
    var tabs = document.querySelectorAll('.auth-tab');
    var panels = {
      'panel-user': document.getElementById('panel-user'),
      'panel-admin': document.getElementById('panel-admin'),
    };
    tabs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        tabs.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        Object.keys(panels).forEach(function (id) {
          if (panels[id]) panels[id].classList.toggle('hidden', id !== btn.getAttribute('data-ks-tab'));
        });
      });
    });
  })();
</script>

<%- include('../partials/footer') %>