<%- include('../partials/header') %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-head">
      <span class="auth-emoji">🔑</span>
      <h1><%= t('forgot.title') %></h1>
      <p><%= t('forgot.sub') %></p>
    </div>

    <% if (sent) { %>
      <div class="notice notice-success">
        ✅ <%= info %>
      </div>

      <% if (demoOtp) { %>
        <div class="notice notice-warn">
          🧪 <strong><%= t('forgot.demoMode') %></strong> — <%= t('forgot.demoNote1') %><br>
          <span class="otp-display"><%= demoOtp %></span><br>
          <span class="small"><%= t('forgot.demoNote2') %></span>
        </div>
      <% } %>

      <a href="/auth/reset" class="btn btn-primary btn-block btn-lg mt"><%= t('forgot.continueOtp') %></a>
    <% } else { %>
      <form method="post" action="/auth/forgot" class="form" novalidate>
        <div class="field">
          <label for="login"><%= t('forgot.adminUserOrEmail') %></label>
          <input type="text" id="login" name="login" value="<%= form.login || '' %>" placeholder="SURYAS" required autofocus>
          <% if (fieldErrors.login) { %><p class="field-error"><%= fieldErrors.login %></p><% } %>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg"><%= t('forgot.sendOtp') %></button>
      </form>
    <% } %>

    <p class="auth-foot"><a href="/auth/login"><%= t('auth.backToLogin') %></a></p>
  </div>
</div>

<%- include('../partials/footer') %>