<%- include('../partials/header') %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-head">
      <span class="auth-emoji">🔐</span>
      <h1><%= t('reset.title') %></h1>
      <p><%= t('reset.sub') %></p>
    </div>

    <% if (demoOtp) { %>
      <div class="notice notice-warn">
        🧪 <strong><%= t('forgot.demoMode') %></strong> — <%= t('forgot.demoNote1') %>
        <span class="otp-display"><%= demoOtp %></span>
      </div>
    <% } %>

    <form method="post" action="/auth/reset" class="form" novalidate>
      <div class="field">
        <label for="login"><%= t('forgot.adminUserOrEmail') %></label>
        <input type="text" id="login" name="login" value="<%= form.login || '' %>" placeholder="SURYAS" required>
        <% if (fieldErrors.login) { %><p class="field-error"><%= fieldErrors.login %></p><% } %>
      </div>

      <div class="field">
        <label for="otp"><%= t('reset.otpLabel') %></label>
        <input type="text" id="otp" name="otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="123456" required>
        <% if (fieldErrors.otp) { %><p class="field-error"><%= fieldErrors.otp %></p><% } %>
      </div>

      <div class="field">
        <label for="password"><%= t('reset.newPass') %></label>
        <input type="password" id="password" name="password" placeholder="••••••••" required>
        <% if (fieldErrors.password) { %><p class="field-error"><%= fieldErrors.password %></p><% } %>
      </div>

      <div class="field">
        <label for="confirm"><%= t('reset.confirmPass') %></label>
        <input type="password" id="confirm" name="confirm" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg"><%= t('reset.updatePass') %></button>
    </form>

    <p class="auth-foot">
      <a href="/auth/login"><%= t('auth.backToLogin') %></a> · <%= t('reset.otpValidFor', { m: otpTtlMin }) %>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>