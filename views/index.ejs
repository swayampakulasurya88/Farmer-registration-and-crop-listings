<%- include('partials/header') %>

<!-- ================= Hero ================= -->
<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-kicker">🌾 <%= config.DISTRICT %> · <%= t('hero.kicker') %></p>
      <h1><%= t('hero.title1') %><br><%= t('hero.title2') %> <span><%= t('hero.title3') %></span></h1>
      <p class="hero-sub"><%= t('hero.sub') %></p>
      <div class="hero-actions">
        <a href="/listings" class="btn btn-primary btn-lg"><%= t('hero.browseBtn') %></a>
        <a href="/auth/login" class="btn btn-light btn-lg"><%= t('hero.enterBtn') %></a>
      </div>
    </div>

    <div class="hero-stats">
      <div class="stat-card">
        <span class="stat-num"><%= stats.farmers %></span>
        <span class="stat-label"><%= t('stats.farmers') %></span>
      </div>
      <div class="stat-card">
        <span class="stat-num"><%= stats.buyers %></span>
        <span class="stat-label"><%= t('stats.buyers') %></span>
      </div>
      <div class="stat-card">
        <span class="stat-num"><%= stats.activeListings %></span>
        <span class="stat-label"><%= t('stats.listings') %></span>
      </div>
    </div>
  </div>
</section>

<!-- ================= How it works ================= -->
<section class="section">
  <div class="container">
    <h2 class="section-title"><%= t('how.title') %></h2>
    <div class="how-grid">
      <div class="how-card">
        <span class="how-num">1</span>
        <h3>👨‍🌾 <%= t('how.s1t') %></h3>
        <p><%= t('how.s1p') %></p>
      </div>
      <div class="how-card">
        <span class="how-num">2</span>
        <h3>🔎 <%= t('how.s2t') %></h3>
        <p><%= t('how.s2p') %></p>
      </div>
      <div class="how-card">
        <span class="how-num">3</span>
        <h3>🤝 <%= t('how.s3t') %></h3>
        <p><%= t('how.s3p') %></p>
      </div>
    </div>
  </div>
</section>

<!-- ================= Recent listings ================= -->
<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 class="section-title"><%= t('home.recentTitle') %></h2>
        <p class="section-sub"><%= t('home.recentSub') %></p>
      </div>
      <a href="/listings" class="btn btn-outline btn-sm"><%= t('home.viewAll') %></a>
    </div>

    <% if (recent.length) { %>
      <div class="grid-listings">
        <% recent.forEach((listing) => { %>
          <%- include('partials/listingCard', { listing }) %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p><%= t('home.noListings') %> <a href="/auth/login"><%= t('home.enterAsFarmer') %></a> <%= t('home.listYourCrop') %></p>
      </div>
    <% } %>
  </div>
</section>

<!-- ================= Price snapshot ================= -->
<% if (priceTable.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 class="section-title"><%= t('home.priceTitle') %></h2>
        <p class="section-sub"><%= t('home.priceSub') %></p>
      </div>
      <a href="/trends" class="btn btn-outline btn-sm"><%= t('home.fullTrends') %></a>
    </div>

    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th><%= t('table.crop') %></th><th><%= t('table.avgPrice') %></th><th><%= t('table.listings') %></th><th><%= t('table.vsPrev') %></th></tr>
        </thead>
        <tbody>
          <% priceTable.forEach((r) => { %>
            <tr>
              <td><strong><%= config.CROP_EMOJI[r.crop] || '🌾' %> <%= r.crop %></strong></td>
              <td><strong>₹<%= r.price %></strong></td>
              <td><%= r.listings %></td>
              <td>
                <% if (r.hasBase && r.change !== null) { %>
                  <% if (r.change > 0) { %>
                    <span class="trend up">▲ <%= Math.abs(r.change) %>%</span>
                  <% } else if (r.change < 0) { %>
                    <span class="trend down">▼ <%= Math.abs(r.change) %>%</span>
                  <% } else { %>
                    <span class="trend flat">— 0%</span>
                  <% } %>
                <% } else { %>
                  <span class="muted"><%= t('table.notEnough') %></span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>
<% } %>

<!-- ================= Role CTA ================= -->
<section class="section cta-banner">
  <div class="container cta-grid">
    <div class="cta-card cta-farmer">
      <h3>👨‍🌾 <%= t('cta.farmerT') %></h3>
      <p><%= t('cta.farmerP') %></p>
      <a href="/farmer/listings/new" class="btn btn-light"><%= t('cta.farmerBtn') %></a>
    </div>
    <div class="cta-card cta-buyer">
      <h3>🛒 <%= t('cta.buyerT') %></h3>
      <p><%= t('cta.buyerP') %></p>
      <a href="/listings" class="btn btn-primary"><%= t('cta.buyerBtn') %></a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>