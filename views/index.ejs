<%- include('partials/header') %>

<!-- ================= Hero ================= -->
<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-kicker">🌾 <%= config.DISTRICT %> · One shared platform</p>
      <h1>Every crop. Every price.<br>Every farmer &amp; buyer — <span>together.</span></h1>
      <p class="hero-sub">
        Farmers post structured listings of what they grow and at what price.
        Buyers search, compare and connect — no more word of mouth or scattered WhatsApp groups.
      </p>
      <div class="hero-actions">
        <a href="/listings" class="btn btn-primary btn-lg">🔍 Browse crop listings</a>
        <a href="/auth/register" class="btn btn-light btn-lg">Register free</a>
      </div>
    </div>

    <div class="hero-stats">
      <div class="stat-card">
        <span class="stat-num"><%= stats.farmers %></span>
        <span class="stat-label">Farmers registered</span>
      </div>
      <div class="stat-card">
        <span class="stat-num"><%= stats.buyers %></span>
        <span class="stat-label">Buyers registered</span>
      </div>
      <div class="stat-card">
        <span class="stat-num"><%= stats.activeListings %></span>
        <span class="stat-label">Live crop listings</span>
      </div>
    </div>
  </div>
</section>

<!-- ================= How it works ================= -->
<section class="section">
  <div class="container">
    <h2 class="section-title">How it works</h2>
    <div class="how-grid">
      <div class="how-card">
        <span class="how-num">1</span>
        <h3>👨‍🌾 Farmer registers &amp; lists</h3>
        <p>Create a free account, then post your crop, variety, quantity, price, quality and pickup village in one structured form.</p>
      </div>
      <div class="how-card">
        <span class="how-num">2</span>
        <h3>🔎 Buyer searches &amp; compares</h3>
        <p>Filter live listings by crop, village, quality and price range. Compare rates across the district instantly.</p>
      </div>
      <div class="how-card">
        <span class="how-num">3</span>
        <h3>🤝 Direct contact, fair price</h3>
        <p>Express interest or save listings. You get the farmer's details directly — no middlemen, transparent rates.</p>
      </div>
    </div>
  </div>
</section>

<!-- ================= Recent listings ================= -->
<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 class="section-title">Fresh on the market</h2>
        <p class="section-sub">Latest structured listings from farmers across the district.</p>
      </div>
      <a href="/listings" class="btn btn-outline btn-sm">View all →</a>
    </div>

    <% if (recent.length) { %>
      <div class="grid-listings">
        <% recent.forEach((listing) => { %>
          <%- include('partials/listingCard', { listing }) %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>No listings yet — be the first! <a href="/auth/register">Register as a farmer</a> and list your crop.</p>
      </div>
    <% } %>
  </div>
</section>

<!-- ================= Price snapshot ================= -->
<% if (priceTable.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 class="section-title">Price snapshot — last 14 days</h2>
        <p class="section-sub">Average quoted rate (₹/kg) from current structured records.</p>
      </div>
      <a href="/trends" class="btn btn-outline btn-sm">Full trends &amp; charts →</a>
    </div>

    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Crop</th><th>Avg price (₹/kg)</th><th>Listings</th><th>vs previous fortnight</th></tr>
        </thead>
        <tbody>
          <% priceTable.forEach((r) => { %>
            <tr>
              <td><strong><%= config.CROP_EMOJI[r.crop] || '🌾' %> <%= r.crop %></strong></td>
              <td><strong>₹<%= r.price %></strong></td>
              <td><%= r.listings %></td>
              <td>
                <% if (r.hasBase && r.change !== null) { %>
                  <% if (r.change > 0) { %>
                    <span class="trend up">▲ <%= Math.abs(r.change) %>%</span>
                  <% } else if (r.change < 0) { %>
                    <span class="trend down">▼ <%= Math.abs(r.change) %>%</span>
                  <% } else { %>
                    <span class="trend flat">— 0%</span>
                  <% } %>
                <% } else { %>
                  <span class="muted">not enough data</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>
<% } %>

<!-- ================= Role CTA ================= -->
<section class="section cta-banner">
  <div class="container cta-grid">
    <div class="cta-card cta-farmer">
      <h3>👨‍🌾 I'm a farmer</h3>
      <p>List your harvest in minutes. Reach every buyer in the district with one structured post.</p>
      <a href="/farmer/listings/new" class="btn btn-light">Post a crop listing</a>
    </div>
    <div class="cta-card cta-buyer">
      <h3>🛒 I'm a buyer</h3>
      <p>Know what's available and at what price before you travel. Compare and connect directly.</p>
      <a href="/listings" class="btn btn-primary">Find crops</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>