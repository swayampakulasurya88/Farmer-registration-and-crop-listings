<%- include('../partials/header') %>

<div class="page-head">
  <h1><%= t('browse.title') %></h1>
  <p><%= t('browse.sub') %> <strong><%= t('browse.found', { n: count, s: count === 1 ? '' : 's' }) %></strong></p>
</div>

<!-- ============ Filter bar ============ -->
<form method="get" action="/listings" class="filter-bar" id="filter-bar">
  <div class="field">
    <label><%= t('browse.search') %></label>
    <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="<%= t('browse.searchPh') %>">
  </div>
  <div class="field">
    <label><%= t('browse.crop') %></label>
    <select name="crop">
      <option value=""><%= t('browse.allCrops') %></option>
      <% cropOptions.forEach((c) => { %>
        <option value="<%= c %>" <%= filters.crop === c ? 'selected' : '' %>><%= c %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label><%= t('browse.village') %></label>
    <select name="village">
      <option value=""><%= t('browse.allVillages') %></option>
      <% villageOptions.forEach((v) => { %>
        <option value="<%= v %>" <%= filters.village === v ? 'selected' : '' %>><%= v %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label><%= t('browse.quality') %></label>
    <select name="quality">
      <option value=""><%= t('browse.any') %></option>
      <% qualities.forEach((q) => { %>
        <option value="<%= q %>" <%= filters.quality === q ? 'selected' : '' %>><%= t('quality.' + q) %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label><%= t('browse.minPrice') %></label>
    <input type="number" min="0" name="minPrice" value="<%= filters.minPrice || '' %>" placeholder="e.g. 20">
  </div>
  <div class="field">
    <label><%= t('browse.maxPrice') %></label>
    <input type="number" min="0" name="maxPrice" value="<%= filters.maxPrice || '' %>" placeholder="e.g. 100">
  </div>
  <div class="field">
    <label><%= t('browse.sortBy') %></label>
    <select name="sort">
      <option value="newest" <%= filters.sort === 'newest' || !filters.sort ? 'selected' : '' %>><%= t('browse.newestFirst') %></option>
      <option value="priceAsc" <%= filters.sort === 'priceAsc' ? 'selected' : '' %>><%= t('browse.priceAsc') %></option>
      <option value="priceDesc" <%= filters.sort === 'priceDesc' ? 'selected' : '' %>><%= t('browse.priceDesc') %></option>
      <option value="qtyDesc" <%= filters.sort === 'qtyDesc' ? 'selected' : '' %>><%= t('browse.qtyDesc') %></option>
    </select>
  </div>
  <div class="field filter-actions">
    <button type="submit" class="btn btn-primary"><%= t('browse.apply') %></button>
    <a href="/listings" class="btn btn-ghost btn-sm"><%= t('browse.reset') %></a>
  </div>
</form>

<!-- ============ Results ============ -->
<% if (listings.length) { %>
  <div class="grid-listings">
    <% listings.forEach((listing) => { %>
      <%- include('../partials/listingCard', { listing }) %>
    <% }) %>
  </div>
<% } else { %>
  <div class="empty-state">
    <p><%= t('browse.noMatch') %> <a href="/listings"><%= t('browse.clearFilters') %></a> <%= t('browse.clearCheck') %></p>
  </div>
<% } %>

<%- include('../partials/footer') %>