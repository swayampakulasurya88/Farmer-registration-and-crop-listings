<%- include('../partials/header') %>

<div class="page-head">
  <h1>Browse crop listings</h1>
  <p>Every listing follows one structured format — crop, variety, quantity, price, quality, date &amp; village — so you can filter and compare them fairly. <strong><%= count %></strong> live listing<%= count === 1 ? '' : 's' %> found.</p>
</div>

<!-- ============ Filter bar ============ -->
<form method="get" action="/listings" class="filter-bar" id="filter-bar">
  <div class="field">
    <label>Search</label>
    <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="crop, variety, village, farmer…">
  </div>
  <div class="field">
    <label>Crop</label>
    <select name="crop">
      <option value="">All crops</option>
      <% cropOptions.forEach((c) => { %>
        <option value="<%= c %>" <%= filters.crop === c ? 'selected' : '' %>><%= c %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label>Village</label>
    <select name="village">
      <option value="">All villages</option>
      <% villageOptions.forEach((v) => { %>
        <option value="<%= v %>" <%= filters.village === v ? 'selected' : '' %>><%= v %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label>Quality</label>
    <select name="quality">
      <option value="">Any</option>
      <% qualities.forEach((q) => { %>
        <option value="<%= q %>" <%= filters.quality === q ? 'selected' : '' %>><%= q %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label>Min price (₹)</label>
    <input type="number" min="0" name="minPrice" value="<%= filters.minPrice || '' %>" placeholder="e.g. 20">
  </div>
  <div class="field">
    <label>Max price (₹)</label>
    <input type="number" min="0" name="maxPrice" value="<%= filters.maxPrice || '' %>" placeholder="e.g. 100">
  </div>
  <div class="field">
    <label>Sort by</label>
    <select name="sort">
      <option value="newest" <%= filters.sort === 'newest' || !filters.sort ? 'selected' : '' %>>Newest first</option>
      <option value="priceAsc" <%= filters.sort === 'priceAsc' ? 'selected' : '' %>>Price: low → high</option>
      <option value="priceDesc" <%= filters.sort === 'priceDesc' ? 'selected' : '' %>>Price: high → low</option>
      <option value="qtyDesc" <%= filters.sort === 'qtyDesc' ? 'selected' : '' %>>Quantity: high → low</option>
    </select>
  </div>
  <div class="field filter-actions">
    <button type="submit" class="btn btn-primary">Apply filters</button>
    <a href="/listings" class="btn btn-ghost btn-sm">Reset</a>
  </div>
</form>

<!-- ============ Results ============ -->
<% if (listings.length) { %>
  <div class="grid-listings">
    <% listings.forEach((listing) => { %>
      <%- include('../partials/listingCard', { listing }) %>
    <% }) %>
  </div>
<% } else { %>
  <div class="empty-state">
    <p>😔 No listings match these filters. <a href="/listings">Clear filters</a> or check back soon.</p>
  </div>
<% } %>

<%- include('../partials/footer') %>