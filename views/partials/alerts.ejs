<% if (typeof msg !== 'undefined' && msg) { %>
  <div class="alert alert-success" role="status">
    <span>✅ <%= msg %></span>
    <button class="alert-close" aria-label="Dismiss">&times;</button>
  </div>
<% } %>
<% if (typeof err !== 'undefined' && err) { %>
  <div class="alert alert-error" role="alert">
    <span>⚠️ <%= err %></span>
    <button class="alert-close" aria-label="Dismiss">&times;</button>
  </div>
<% } %>