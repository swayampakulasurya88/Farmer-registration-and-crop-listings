<%- include('partials/header') %>

<div class="form-card">
  <div class="card">
    <div class="auth-head" style="text-align:left">
      <span class="auth-emoji">✏️</span>
      <h1><%= t('profile.title') %></h1>
      <p><%= t('profile.sub') %></p>
    </div>

    <form method="post" action="/auth/profile" class="form" novalidate>
      <div class="form-grid">
        <div class="field">
          <label for="name"><%= t('auth.fullName') %></label>
          <input type="text" id="name" name="name" value="<%= form.name || '' %>" required>
          <% if (fieldErrors.name) { %><p class="field-error"><%= fieldErrors.name %></p><% } %>
        </div>
        <div class="field">
          <label for="phone"><%= t('auth.mobile') %></label>
          <input type="tel" id="phone" name="phone" value="<%= form.phone || '' %>" required>
          <% if (fieldErrors.phone) { %><p class="field-error"><%= fieldErrors.phone %></p><% } %>
        </div>
        <div class="field">
          <label for="village"><%= t('auth.village') %></label>
          <select id="village" name="village">
            <option value=""><%= t('auth.select') %></option>
            <% villages.forEach((v) => { %>
              <option value="<%= v %>" <%= form.village === v ? 'selected' : '' %>><%= v %></option>
            <% }) %>
          </select>
          <% if (fieldErrors.village) { %><p class="field-error"><%= fieldErrors.village %></p><% } %>
        </div>
        <div class="field">
          <label for="email"><%= t('profile.emailOptional') %></label>
          <input type="email" id="email" name="email" value="<%= form.email || '' %>" placeholder="you@example.com">
          <% if (fieldErrors.email) { %><p class="field-error"><%= fieldErrors.email %></p><% } %>
        </div>

        <div class="field field-full">
          <label for="address"><%= t('profile.addressLabel') %></label>
          <textarea id="address" name="address" rows="2" placeholder="<%= t('auth.addressPh') %>"><%= form.address || '' %></textarea>
          <% if (fieldErrors.address) { %><p class="field-error"><%= fieldErrors.address %></p><% } %>
        </div>

        <% if (currentUser.role === 'farmer') { %>
          <div class="field">
            <label for="landSize"><%= t('profile.landSize') %></label>
            <input type="text" id="landSize" name="landSize" value="<%= form.landSize || '' %>" placeholder="<%= t('auth.landSizePh') %>">
          </div>
        <% } else if (currentUser.role === 'buyer') { %>
          <div class="field">
            <label for="businessType"><%= t('profile.businessType') %></label>
            <select id="businessType" name="businessType">
              <option value=""><%= t('auth.select') %></option>
              <% businessTypes.forEach((t) => { %>
                <option value="<%= t %>" <%= form.businessType === t ? 'selected' : '' %>><%= t %></option>
              <% }) %>
            </select>
          </div>
        <% } %>
      </div>

      <div class="form-actions">
        <a href="/" class="btn btn-ghost"><%= t('profile.cancel') %></a>
        <button type="submit" class="btn btn-primary"><%= t('profile.save') %></button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>