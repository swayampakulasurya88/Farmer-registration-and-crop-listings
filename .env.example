# KrishiSetu configuration — copy to .env and fill in. Keep .env secret
# (it is git-ignored). Every value is optional for a local demo.

# --- Identity of the district the platform serves ---------------------------
DISTRICT=Krishna District
STATE=Andhra Pradesh
PORT=3000

# --- PostgreSQL (forgot-password OTP store) ----------------------------------
# Local: the embedded PostgreSQL cluster starts automatically, no config
# needed. These override its defaults:
PG_PORT=5433
PG_USER=krishisetu
PG_PASS=krishisetu
PG_DATABASE=krishisetu

# Optional — connect to your OWN Postgres server instead of the embedded one
# (recommended in production; docker-compose.yml sets this automatically):
#DATABASE_URL=postgres://krishisetu:krishisetu@localhost:5432/krishisetu

# --- Sessions -----------------------------------------------------------------
# MUST be a long random string in production (sessions are signed with it):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-change-me-to-a-long-random-string

# --- Forgot-password email (real OTP emails) ----------------------------------
# Leave SMTP_HOST empty → DEMO MODE: the OTP is shown on screen + server
# console (works with zero email setup).
# To send real emails use a Gmail App Password (Google Account → Security →
# 2-Step Verification ON → App passwords):
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@gmail.com
#SMTP_PASS=16-character-app-password
#MAIL_FROM=KrishiSetu <no-reply@yourdomain.com>

# --- Firebase mirror (optional realtime copy) ----------------------------------
#FIREBASE_SERVICE_ACCOUNT=/path/to/serviceAccount.json
#FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# --- Where the SQLite data file lives ------------------------------------------
# Docker sets this to /app/data automatically. On a bare server you can put
# the database anywhere writable:
#DATA_DIR=/app/data